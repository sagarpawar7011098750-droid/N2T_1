CHIP CPU {
    IN  inM[16],         // M value input (M = contents of RAM[A])
        instruction[16], // Instruction for execution
        reset;           // Signals whether to restart the current program

    OUT outM[16],        // M value output
        writeM,          // Write to M? 
        addressM[15],    // Address in data memory (of M)
        pc[15];          // Address of next instruction

    PARTS:
    // Instruction type: 0 = A-instruction, 1 = C-instruction
    Not(in=instruction[15], out=isAInst);
    Not(in=isAInst, out=isCInst);

    // A Register
    Mux16(a=instruction, b=aluOut, sel=isCInst, out=aRegIn);
    And(a=isCInst, b=instruction[5], out=destA);
    Or(a=isAInst, b=destA, out=loadA);
    ARegister(in=aRegIn, load=loadA, out=aRegOut, out[0..14]=addressM);

    // D Register
    And(a=isCInst, b=instruction[4], out=loadD);
    DRegister(in=aluOut, load=loadD, out=dRegOut);

    // Select A or M for ALU Y-input (a-bit is instruction[12])
    Mux16(a=aRegOut, b=inM, sel=instruction[12], out=aluY);

    // ALU
    ALU(x=dRegOut, y=aluY,
        zx=instruction[11], nx=instruction[10],
        zy=instruction[9],  ny=instruction[8],
        f=instruction[7],   no=instruction[6],
        out=aluOut, out=outM, zr=zrOut, ng=ngOut);

    // writeM (d3 is instruction[3])
    And(a=isCInst, b=instruction[3], out=writeM);

    // Jump logic
    Or(a=zrOut, b=ngOut, out=zrOrNg);
    Not(in=zrOrNg, out=posOut); // Positive (> 0)

    And(a=instruction[0], b=posOut, out=jgt);
    And(a=instruction[1], b=zrOut,  out=jeq);
    And(a=instruction[2], b=ngOut,  out=jlt);

    Or(a=jgt, b=jeq, out=jge);
    Or(a=jge, b=jlt, out=jmpCondition);
    And(a=isCInst, b=jmpCondition, out=pcLoad);

    PC(in=aRegOut, load=pcLoad, inc=true, reset=reset, out[0..14]=pc);
}